    phone        String
    email        String?
    address      String?
    isPrimary    Boolean @default(false)
    patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@map("emergency_contacts")
  }

  model EmergencyVisit {
    id               String                                                    @id @default(uuid())
    visitNo          String
    patientId        String?
    walkinName       String?
    walkinAge        Int?
    walkinGender     pg.enum(Gender)?
    triageTime       TimestampString(3)                                        @default(now())
