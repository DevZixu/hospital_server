  model Surgery {
    id               String                                                    @id @default(uuid())
    surgeryNo        String
    patientId        String
    admissionId      String?
    leadSurgeonId    String
    procedureName    String
    icdProcedureCode String?
    priority         pg.enum(SurgeryPriority)                                  @default("ELECTIVE")
    status           pg.enum(SurgeryStatus)                                    @default("SCHEDULED")
    operatingRoom    String?
    scheduledAt      TimestampString(3)
    startedAt        TimestampString(3)?
    endedAt          TimestampString(3)?
    duration         Int?
    anesthesiaType   String?
    anesthesiologist String?
    preOpDiagnosis   String?
    postOpDiagnosis  String?
    findings         String?
    complications    String?
    notes            String?
    estimatedCost    Float?
    createdAt        TimestampString(3)                                        @default(now())
    updatedAt        temporal.timestampString(3, onCreate: now, onUpdate: now)
    staff            SurgeryStaff[]
    patient          Patient                                                   @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
