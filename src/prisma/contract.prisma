    claimedAmount  Float?
    approvedAmount Float?
    status         String              @default("PENDING")
    submittedAt    TimestampString(3)?
    resolvedAt     TimestampString(3)?
    notes          String?
    bill           Bill                @relation(fields: [billId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    insurance      Insurance           @relation(fields: [insuranceId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@map("bill_insurances")
  }

  model BillItem {
    id          String  @id @default(uuid())
    billId      String
    description String
    category    String
    quantity    Int     @default(1)
    unitPrice   Float
    totalPrice  Float
    discount    Float   @default(0)
    notes       String?
    bill        Bill    @relation(fields: [billId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@map("bill_items")
  }

  model MedicalRecord {
    id                      String                                                    @id @default(uuid())
    recordNo                String
    patientId               String
    doctorId                String
    appointmentId           String?
    admissionId             String?
    visitDate               TimestampString(3)                                        @default(now())
    chiefComplaint          String?
    historyOfPresentIllness String?
    pastMedicalHistory      String?
    familyHistory           String?
    socialHistory           String?
    reviewOfSystems         String?
    physicalExamination     String?
