    diagnosedAt     TimestampString(3) @default(now())
    medicalRecord   MedicalRecord      @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)

    @@map("diagnoses")
  }

  model EmergencyContact {
    id           String  @id @default(uuid())
