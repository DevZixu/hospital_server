    updatedAt          temporal.timestampString(3, onCreate: now, onUpdate: now)
    patient            Patient                                                   @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    referringDoctor    Doctor                                                    @relation(name: "Referral_referringDoctor", fields: [referringDoctorId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    referredToDoctor   Doctor?                                                   @relation(name: "Referral_referredToDoctor", fields: [referredToDoctorId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

