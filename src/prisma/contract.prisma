    @@index([surgeryNo], map: "surgeries_surgeryNo_key", unique: true)
    @@index([patientId], map: "surgeries_patientId_idx")
    @@map("surgeries")
  }

  model SurgeryStaff {
    id        String  @id @default(uuid())
    surgeryId String
    staffId   String
    role      String
