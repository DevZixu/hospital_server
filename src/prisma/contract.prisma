    updatedAt          temporal.timestampString(3, onCreate: now, onUpdate: now)
    patient            Patient                                                   @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    doctor             Doctor                                                    @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    medicalRecord      MedicalRecord?                                            @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

