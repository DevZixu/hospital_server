// use prisma-8
// Printed from prisma/schema.prisma by `prisma contract print`.

namespace public {
  model User {
    id                  String                                                    @id @default(uuid())
    email               String
    password            String
    role                pg.enum(Role)
    isActive            Boolean                                                   @default(true)
    isEmailVerified     Boolean                                                   @default(false)
    emailVerifyToken    String?
    passwordResetToken  String?
    passwordResetExpiry TimestampString(3)?
    lastLoginAt         TimestampString(3)?
    createdAt           TimestampString(3)                                        @default(now())
    updatedAt           temporal.timestampString(3, onCreate: now, onUpdate: now)
    auditLogs           AuditLog[]
    notifications       Notification[]
    patient             Patient?
    refreshTokens       RefreshToken[]
    staff               Staff?

    @@index([email], map: "users_email_key", unique: true)
    @@map("users")
  }

  model Staff {
    id           String                                                    @id @default(uuid())
    userId       String
    staffId      String
    firstName    String
    lastName     String
    middleName   String?
    gender       pg.enum(Gender)
    dateOfBirth  TimestampString(3)
    phone        String
    address      String?
    city         String?
    state        String?
    country      String                                                    @default("NG")
    departmentId String?
    position     String?
    hireDate     TimestampString(3)
    salary       Float?
    profilePhoto String?
    isOnDuty     Boolean                                                   @default(false)
    createdAt    TimestampString(3)                                        @default(now())
    updatedAt    temporal.timestampString(3, onCreate: now, onUpdate: now)
    doctor       Doctor?
    nurse        Nurse?
    shifts       Shift[]
    surgeryStaff SurgeryStaff[]
    user         User                                                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
    department   Department?                                               @relation(name: "Staff_department", fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    headOf       Department[]                                              @relation(name: "Department_head")

    @@index([userId], map: "staff_userId_key", unique: true)
    @@index([staffId], map: "staff_staffId_key", unique: true)
    @@map("staff")
  }

  model Department {
    id           String                                                    @id @default(uuid())
    name         String
    code         String
    description  String?
    headId       String?
    isActive     Boolean                                                   @default(true)
    createdAt    TimestampString(3)                                        @default(now())
    updatedAt    temporal.timestampString(3, onCreate: now, onUpdate: now)
    appointments Appointment[]
    wards        Ward[]
    head         Staff?                                                    @relation(name: "Department_head", fields: [headId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    staff        Staff[]                                                   @relation(name: "Staff_department")

    @@index([name], map: "departments_name_key", unique: true)
    @@index([code], map: "departments_code_key", unique: true)
    @@map("departments")
  }

  model Ward {
    id           String                                                    @id @default(uuid())
    name         String
    wardCode     String
    departmentId String?
    type         pg.enum(BedType)                                          @default("GENERAL")
    floor        Int?
    building     String?
    capacity     Int
    isActive     Boolean                                                   @default(true)
    createdAt    TimestampString(3)                                        @default(now())
    updatedAt    temporal.timestampString(3, onCreate: now, onUpdate: now)
    beds         Bed[]
    nurses       Nurse[]
    department   Department?                                               @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

    @@index([wardCode], map: "wards_wardCode_key", unique: true)
    @@map("wards")
  }

  model Bed {
    id         String                                                    @id @default(uuid())
    bedNumber  String
    wardId     String
    type       pg.enum(BedType)                                          @default("GENERAL")
    status     pg.enum(BedStatus)                                        @default("AVAILABLE")
    notes      String?
    createdAt  TimestampString(3)                                        @default(now())
    updatedAt  temporal.timestampString(3, onCreate: now, onUpdate: now)
    admissions Admission[]
    ward       Ward                                                      @relation(fields: [wardId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@index([wardId, bedNumber], map: "beds_wardId_bedNumber_key", unique: true)
    @@map("beds")
  }

  model Patient {
    id                String                                                    @id @default(uuid())
    userId            String?
    patientId         String
    firstName         String
    lastName          String
    middleName        String?
    gender            pg.enum(Gender)
    dateOfBirth       TimestampString(3)
    phone             String
    email             String?
    address           String?
    city              String?
    state             String?
    country           String                                                    @default("NG")
    bloodGroup        pg.enum(BloodGroup)                                       @default("UNKNOWN")
    genotype          String?
    maritalStatus     pg.enum(MaritalStatus)                                    @default("SINGLE")
    occupation        String?
    nationality       String?
    profilePhoto      String?
    nextOfKinName     String?
    nextOfKinPhone    String?
    nextOfKinRelation String?
    allergies         String[]?                                                 @noCheck(elementNotNull)
    chronicConditions String[]?                                                 @noCheck(elementNotNull)
    isDeceased        Boolean                                                   @default(false)
    deceasedAt        TimestampString(3)?
    createdAt         TimestampString(3)                                        @default(now())
    updatedAt         temporal.timestampString(3, onCreate: now, onUpdate: now)
    admissions        Admission[]
    appointments      Appointment[]
    bills             Bill[]
    documents         MedicalDocument[]
    emergencyContacts EmergencyContact[]
    emergencyVisits   EmergencyVisit[]
    immunizations     Immunization[]
    insurances        Insurance[]
    labOrders         LabOrder[]
    medicalRecords    MedicalRecord[]
    prescriptions     Prescription[]
    radiologyOrders   RadiologyOrder[]
    referrals         Referral[]
    surgeries         Surgery[]
    vitalSigns        VitalSign[]
    user              User?                                                     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

    @@index([userId], map: "patients_userId_key", unique: true)
    @@index([patientId], map: "patients_patientId_key", unique: true)
    @@map("patients")
  }

  model Admission {
    id                String                                                    @id @default(uuid())
    admissionNo       String
    patientId         String
    bedId             String?
    admittingDoctorId String?
    admissionReason   String
    admissionDate     TimestampString(3)                                        @default(now())
    expectedDischarge TimestampString(3)?
    dischargeDate     TimestampString(3)?
    dischargeNotes    String?
    status            pg.enum(AdmissionStatus)                                  @default("ADMITTED")
    referralSource    String?
    transferNotes     String?
    createdAt         TimestampString(3)                                        @default(now())
    updatedAt         temporal.timestampString(3, onCreate: now, onUpdate: now)
    medicalRecords    MedicalRecord[]
    surgeries         Surgery[]
    vitalSigns        VitalSign[]
    patient           Patient                                                   @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    bed               Bed?                                                      @relation(fields: [bedId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

    @@index([admissionNo], map: "admissions_admissionNo_key", unique: true)
    @@index([patientId], map: "admissions_patientId_idx")
    @@map("admissions")
  }

  model Specialization {
    id          String   @id @default(uuid())
    name        String
    description String?
    doctors     Doctor[]

    @@index([name], map: "specializations_name_key", unique: true)
    @@map("specializations")
  }

  model Doctor {
    id                String           @id @default(uuid())
    staffId           String
    licenseNumber     String
    specializationId  String?
    qualification     String
    experience        Int              @default(0)
    consultationFee   Float            @default(0)
    isAvailable       Boolean          @default(true)
    bio               String?
    appointments      Appointment[]
    labOrders         LabOrder[]
    medicalRecords    MedicalRecord[]
    prescriptions     Prescription[]
    radiologyOrders   RadiologyOrder[]
    surgeries         Surgery[]
    staff             Staff            @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
    specialization    Specialization?  @relation(fields: [specializationId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    referrals         Referral[]       @relation(name: "Referral_referringDoctor")
    referralsReceived Referral[]       @relation(name: "Referral_referredToDoctor")

    @@index([staffId], map: "doctors_staffId_key", unique: true)
    @@index([licenseNumber], map: "doctors_licenseNumber_key", unique: true)
    @@map("doctors")
  }

  model Appointment {
    id                  String                                                    @id @default(uuid())
    appointmentNo       String
    patientId           String
    doctorId            String
    departmentId        String?
    type                pg.enum(AppointmentType)                                  @default("CONSULTATION")
    status              pg.enum(AppointmentStatus)                                @default("SCHEDULED")
    scheduledAt         TimestampString(3)
    duration            Int                                                       @default(30)
    checkedInAt         TimestampString(3)?
    completedAt         TimestampString(3)?
    cancelledAt         TimestampString(3)?
    cancellationReason  String?
    chiefComplaint      String?
    notes               String?
    isFollowUp          Boolean                                                   @default(false)
    parentAppointmentId String?
    createdAt           TimestampString(3)                                        @default(now())
    updatedAt           temporal.timestampString(3, onCreate: now, onUpdate: now)
    medicalRecord       MedicalRecord?
    patient             Patient                                                   @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    doctor              Doctor                                                    @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    department          Department?                                               @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    parentAppointment   Appointment?                                              @relation(name: "Appointment_parentAppointment", fields: [parentAppointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)
    followUps           Appointment[]                                             @relation(name: "Appointment_parentAppointment")

    @@index([appointmentNo], map: "appointments_appointmentNo_key", unique: true)
    @@index([scheduledAt], map: "appointments_scheduledAt_idx")
    @@index([patientId], map: "appointments_patientId_idx")
    @@index([doctorId], map: "appointments_doctorId_idx")
    @@map("appointments")
  }

  model AuditLog {
    id         String             @id @default(uuid())
    userId     String?
    action     String
    resource   String
    resourceId String?
    oldValue   Jsonb?
    newValue   Jsonb?
    ipAddress  String?
    userAgent  String?
    createdAt  TimestampString(3) @default(now())
    user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

    @@index([userId], map: "audit_logs_userId_idx")
    @@index([resource], map: "audit_logs_resource_idx")
    @@index([createdAt], map: "audit_logs_createdAt_idx")
    @@map("audit_logs")
  }

  model Bill {
    id             String                                                    @id @default(uuid())
    billNo         String
    patientId      String
    admissionId    String?
    totalAmount    Float                                                     @default(0)
    discountAmount Float                                                     @default(0)
    taxAmount      Float                                                     @default(0)
    netAmount      Float                                                     @default(0)
    paidAmount     Float                                                     @default(0)
    balanceAmount  Float                                                     @default(0)
    status         pg.enum(BillStatus)                                       @default("PENDING")
    dueDate        TimestampString(3)?
    notes          String?
    createdAt      TimestampString(3)                                        @default(now())
    updatedAt      temporal.timestampString(3, onCreate: now, onUpdate: now)
    insurances     BillInsurance[]
    items          BillItem[]
    payments       Payment[]
    patient        Patient                                                   @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@index([billNo], map: "bills_billNo_key", unique: true)
    @@index([patientId], map: "bills_patientId_idx")
    @@map("bills")
  }

  model Insurance {
    id               String                                                    @id @default(uuid())
    patientId        String
    providerName     String
    policyNumber     String
    groupNumber      String?
    memberName       String?
    memberDob        TimestampString(3)?
    coverageType     String?
    coverageAmount   Float?
    deductible       Float?
    copay            Float?
    startDate        TimestampString(3)
    endDate          TimestampString(3)?
    status           pg.enum(InsuranceStatus)                                  @default("ACTIVE")
    isPrimary        Boolean                                                   @default(true)
    verificationDate TimestampString(3)?
    verifiedBy       String?
    createdAt        TimestampString(3)                                        @default(now())
    updatedAt        temporal.timestampString(3, onCreate: now, onUpdate: now)
    billInsurances   BillInsurance[]
