    sellingPrice  Float
    expiryDate    TimestampString(3)
    supplier      String?
    receivedDate  TimestampString(3)                                        @default(now())
    createdAt     TimestampString(3)                                        @default(now())
    updatedAt     temporal.timestampString(3, onCreate: now, onUpdate: now)
    medication    Medication                                                @relation(fields: [medicationId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@map("pharmacy_stock")
  }

  model Prescription {
    id              String                                                    @id @default(uuid())
    prescriptionNo  String
    patientId       String
    doctorId        String
    medicalRecordId String?
    status          pg.enum(PrescriptionStatus)                               @default("PENDING")
    prescribedAt    TimestampString(3)                                        @default(now())
    validUntil      TimestampString(3)?
    notes           String?
    isRefillable    Boolean                                                   @default(false)
    refillCount     Int                                                       @default(0)
    dispensedAt     TimestampString(3)?
    dispensedBy     String?
    createdAt       TimestampString(3)                                        @default(now())
    updatedAt       temporal.timestampString(3, onCreate: now, onUpdate: now)
    items           PrescriptionItem[]
    patient         Patient                                                   @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    doctor          Doctor                                                    @relation(fields: [doctorId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
    medicalRecord   MedicalRecord?                                            @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade, index: false)

    @@index([prescriptionNo], map: "prescriptions_prescriptionNo_key", unique: true)
    @@index([patientId], map: "prescriptions_patientId_idx")
    @@map("prescriptions")
  }

  model PrescriptionItem {
    id             String                       @id @default(uuid())
    prescriptionId String
    medicationId   String
    dosage         String
    route          pg.enum(MedicationRoute)     @default("ORAL")
    frequency      pg.enum(MedicationFrequency) @default("ONCE_DAILY")
    duration       Int?
    durationUnit   String?
    quantity       Int
    instructions   String?
    dispensedQty   Int                          @default(0)
    prescription   Prescription                 @relation(fields: [prescriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade, index: false)
    medication     Medication                   @relation(fields: [medicationId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)

    @@map("prescription_items")
  }

  model RadiologyOrder {
    id                 String                                                    @id @default(uuid())
    orderNo            String
    patientId          String
    doctorId           String
    medicalRecordId    String?
