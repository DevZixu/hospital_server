generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  NURSE
  PHARMACIST
  LAB_TECHNICIAN
  RECEPTIONIST
  BILLING_STAFF
  RADIOLOGIST
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  ROUTINE_CHECKUP
  SURGERY_PRE_OP
  SURGERY_POST_OP
  TELEMEDICINE
  LAB_REVIEW
  VACCINATION
  PHYSICAL_THERAPY
}

enum AdmissionStatus {
  PENDING
  ADMITTED
  TRANSFERRED
  DISCHARGED
  DECEASED
}

enum BedType {
  GENERAL
  PRIVATE
  ICU
  NICU
  EMERGENCY
  ISOLATION
  MATERNITY
  PEDIATRIC
  SURGICAL
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  PARTIALLY_DISPENSED
  CANCELLED
  EXPIRED
}

enum MedicationRoute {
  ORAL
  INTRAVENOUS
  INTRAMUSCULAR
  SUBCUTANEOUS
  TOPICAL
  INHALATION
  RECTAL
  SUBLINGUAL
  NASAL
  OPHTHALMIC
  OTIC
  TRANSDERMAL
}

enum MedicationFrequency {
  ONCE_DAILY
  TWICE_DAILY
  THREE_TIMES_DAILY
  FOUR_TIMES_DAILY
  EVERY_6_HOURS
  EVERY_8_HOURS
  EVERY_12_HOURS
  AS_NEEDED
  WEEKLY
  BIWEEKLY
  MONTHLY
  STAT
}

enum LabTestStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum LabTestPriority {
  ROUTINE
  URGENT
  STAT
}

enum BillStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
  INSURANCE_PENDING
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
  MOBILE_PAYMENT
  CHECK
}

enum SurgeryStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum SurgeryPriority {
  ELECTIVE
  URGENT
  EMERGENCY
}

enum EmergencyPriority {
  P1_IMMEDIATE
  P2_URGENT
  P3_LESS_URGENT
  P4_NON_URGENT
}

enum EmergencyStatus {
  TRIAGED
  WAITING
  IN_TREATMENT
  ADMITTED
  TRANSFERRED
  DISCHARGED
  DECEASED
}

enum NotificationType {
  APPOINTMENT_REMINDER
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  LAB_RESULT_READY
  PRESCRIPTION_READY
  BILL_GENERATED
  BILL_OVERDUE
  DISCHARGE_SUMMARY
  EMERGENCY_ALERT
  GENERAL
}

enum InsuranceStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
  EXPIRED
  SUSPENDED
}

enum DocumentType {
  LAB_REPORT
  RADIOLOGY_REPORT
  DISCHARGE_SUMMARY
  CONSENT_FORM
  INSURANCE_DOCUMENT
  REFERRAL_LETTER
  PRESCRIPTION
  MEDICAL_CERTIFICATE
  OTHER
}

enum RadiologyStatus {
  ORDERED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REPORTED
}

enum ImagingModality {
  X_RAY
  CT_SCAN
  MRI
  ULTRASOUND
  ECHO
  ECG
  PET_SCAN
  MAMMOGRAPHY
  FLUOROSCOPY
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  ON_CALL
}

// ─────────────────────────────────────────────
//  CORE USER & AUTH
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  role                Role
  isActive            Boolean   @default(true)
  isEmailVerified     Boolean   @default(false)
  emailVerifyToken    String?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  lastLoginAt         DateTime?
  refreshTokens       RefreshToken[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  staff         Staff?
  patient       Patient?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
//  DEPARTMENT & SPECIALIZATIONS
// ─────────────────────────────────────────────

model Department {
  id          String  @id @default(uuid())
  name        String  @unique
  code        String  @unique
  description String?
  headId      String?
  head        Staff?  @relation("DepartmentHead", fields: [headId], references: [id])
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff        Staff[]       @relation("StaffDepartment")
  wards        Ward[]
  appointments Appointment[]

  @@map("departments")
}

model Specialization {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  doctors     Doctor[]

  @@map("specializations")
}

// ─────────────────────────────────────────────
//  STAFF
// ─────────────────────────────────────────────

model Staff {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId      String    @unique
  firstName    String
  lastName     String
  middleName   String?
  gender       Gender
  dateOfBirth  DateTime
  phone        String
  address      String?
  city         String?
  state        String?
  country      String    @default("NG")
  departmentId String?
  department   Department? @relation("StaffDepartment", fields: [departmentId], references: [id])
  position     String?
  hireDate     DateTime
  salary       Float?
  profilePhoto String?
  isOnDuty     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  doctor       Doctor?
  nurse        Nurse?
  shifts       Shift[]
  headOf       Department[]   @relation("DepartmentHead")
  surgeryStaff SurgeryStaff[]

  @@map("staff")
}

model Doctor {
  id               String  @id @default(uuid())
  staffId          String  @unique
  staff            Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  licenseNumber    String  @unique
  specializationId String?
  specialization   Specialization? @relation(fields: [specializationId], references: [id])
  qualification    String
  experience       Int     @default(0)
  consultationFee  Float   @default(0)
  isAvailable      Boolean @default(true)
  bio              String?

  appointments      Appointment[]
  prescriptions     Prescription[]
  medicalRecords    MedicalRecord[]
  labOrders         LabOrder[]
  surgeries         Surgery[]
  radiologyOrders   RadiologyOrder[]
  referrals         Referral[]  @relation("ReferringDoctor")
  referralsReceived Referral[]  @relation("ReferredToDoctor")

  @@map("doctors")
}

model Nurse {
  id            String  @id @default(uuid())
  staffId       String  @unique
  staff         Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  licenseNumber String  @unique
  nurseType     String?
  wardId        String?
  ward          Ward?   @relation(fields: [wardId], references: [id])

  vitalSigns VitalSign[]
  nurseNotes NurseNote[]

  @@map("nurses")
}

// ─────────────────────────────────────────────
//  PATIENT
// ─────────────────────────────────────────────

model Patient {
  id                String        @id @default(uuid())
  userId            String?       @unique
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientId         String        @unique
  firstName         String
  lastName          String
  middleName        String?
  gender            Gender
  dateOfBirth       DateTime
  phone             String
  email             String?
  address           String?
  city              String?
  state             String?
  country           String        @default("NG")
  bloodGroup        BloodGroup    @default(UNKNOWN)
  genotype          String?
  maritalStatus     MaritalStatus @default(SINGLE)
  occupation        String?
  nationality       String?
  profilePhoto      String?
  nextOfKinName     String?
  nextOfKinPhone    String?
  nextOfKinRelation String?
  allergies         String[]
  chronicConditions String[]
  isDeceased        Boolean       @default(false)
  deceasedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  emergencyContacts EmergencyContact[]
  insurances        Insurance[]
  appointments      Appointment[]
  medicalRecords    MedicalRecord[]
  admissions        Admission[]
  prescriptions     Prescription[]
  labOrders         LabOrder[]
  bills             Bill[]
  vitalSigns        VitalSign[]
  documents         MedicalDocument[]
  radiologyOrders   RadiologyOrder[]
  referrals         Referral[]
  emergencyVisits   EmergencyVisit[]
  immunizations     Immunization[]
  surgeries         Surgery[]

  @@map("patients")
}

model EmergencyContact {
  id           String  @id @default(uuid())
  patientId    String
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
  address      String?
  isPrimary    Boolean @default(false)

  @@map("emergency_contacts")
}

model Insurance {
  id               String          @id @default(uuid())
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerName     String
  policyNumber     String
  groupNumber      String?
  memberName       String?
  memberDob        DateTime?
  coverageType     String?
  coverageAmount   Float?
  deductible       Float?
  copay            Float?
  startDate        DateTime
  endDate          DateTime?
  status           InsuranceStatus @default(ACTIVE)
  isPrimary        Boolean         @default(true)
  verificationDate DateTime?
  verifiedBy       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  billInsurances BillInsurance[]

  @@map("insurances")
}

// ─────────────────────────────────────────────
//  APPOINTMENTS
// ─────────────────────────────────────────────

model Appointment {
  id                 String            @id @default(uuid())
  appointmentNo      String            @unique
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id])
  doctorId           String
  doctor             Doctor            @relation(fields: [doctorId], references: [id])
  departmentId       String?
  department         Department?       @relation(fields: [departmentId], references: [id])
  type               AppointmentType   @default(CONSULTATION)
  status             AppointmentStatus @default(SCHEDULED)
  scheduledAt        DateTime
  duration           Int               @default(30)
  checkedInAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  chiefComplaint     String?
  notes              String?
  isFollowUp         Boolean           @default(false)
  parentAppointmentId String?
  parentAppointment   Appointment?     @relation("AppointmentFollowUp", fields: [parentAppointmentId], references: [id])
  followUps           Appointment[]    @relation("AppointmentFollowUp")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  medicalRecord MedicalRecord?

  @@index([scheduledAt])
  @@index([patientId])
  @@index([doctorId])
  @@map("appointments")
}

// ─────────────────────────────────────────────
//  MEDICAL RECORDS
// ─────────────────────────────────────────────

model MedicalRecord {
  id                      String    @id @default(uuid())
  recordNo                String    @unique
  patientId               String
  patient                 Patient   @relation(fields: [patientId], references: [id])
  doctorId                String
  doctor                  Doctor    @relation(fields: [doctorId], references: [id])
  appointmentId           String?   @unique
  appointment             Appointment? @relation(fields: [appointmentId], references: [id])
  admissionId             String?
  admission               Admission?   @relation(fields: [admissionId], references: [id])
  visitDate               DateTime  @default(now())
  chiefComplaint          String?
  historyOfPresentIllness String?
  pastMedicalHistory      String?
  familyHistory           String?
  socialHistory           String?
  reviewOfSystems         String?
  physicalExamination     String?
  assessment              String?
  plan                    String?
  followUpDate            DateTime?
  followUpNotes           String?
  isConfidential          Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  diagnoses       Diagnosis[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  vitalSigns      VitalSign[]
  nurseNotes      NurseNote[]
  radiologyOrders RadiologyOrder[]

  @@index([patientId])
  @@map("medical_records")
}

model Diagnosis {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  icdCode         String?
  name            String
  description     String?
  isPrimary       Boolean       @default(false)
  diagnosedAt     DateTime      @default(now())

  @@map("diagnoses")
}

// ─────────────────────────────────────────────
//  VITALS
// ─────────────────────────────────────────────

model VitalSign {
  id                     String        @id @default(uuid())
  patientId              String
  patient                Patient       @relation(fields: [patientId], references: [id])
  medicalRecordId        String?
  medicalRecord          MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  admissionId            String?
  admission              Admission?    @relation(fields: [admissionId], references: [id])
  nurseId                String?
  nurse                  Nurse?        @relation(fields: [nurseId], references: [id])
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  temperature            Float?
  temperatureUnit        String        @default("C")
  respiratoryRate        Int?
  oxygenSaturation       Float?
  weight                 Float?
  weightUnit             String        @default("kg")
  height                 Float?
  heightUnit             String        @default("cm")
  bmi                    Float?
  bloodGlucose           Float?
  bloodGlucoseUnit       String        @default("mg/dL")
  painScale              Int?
  notes                  String?
  recordedAt             DateTime      @default(now())

  @@index([patientId])
  @@map("vital_signs")
}

// ─────────────────────────────────────────────
//  WARDS & BEDS
// ─────────────────────────────────────────────

model Ward {
  id           String     @id @default(uuid())
  name         String
  wardCode     String     @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  type         BedType    @default(GENERAL)
  floor        Int?
  building     String?
  capacity     Int
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  beds   Bed[]
  nurses Nurse[]

  @@map("wards")
}

model Bed {
  id        String    @id @default(uuid())
  bedNumber String
  wardId    String
  ward      Ward      @relation(fields: [wardId], references: [id])
  type      BedType   @default(GENERAL)
  status    BedStatus @default(AVAILABLE)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  admissions Admission[]

  @@unique([wardId, bedNumber])
  @@map("beds")
}

// ─────────────────────────────────────────────
//  ADMISSIONS
// ─────────────────────────────────────────────

model Admission {
  id                String          @id @default(uuid())
  admissionNo       String          @unique
  patientId         String
  patient           Patient         @relation(fields: [patientId], references: [id])
  bedId             String?
  bed               Bed?            @relation(fields: [bedId], references: [id])
  admittingDoctorId String?
  admissionReason   String
  admissionDate     DateTime        @default(now())
  expectedDischarge DateTime?
  dischargeDate     DateTime?
  dischargeNotes    String?
  status            AdmissionStatus @default(ADMITTED)
  referralSource    String?
  transferNotes     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  medicalRecords MedicalRecord[]
  vitalSigns     VitalSign[]
  surgeries      Surgery[]

  @@index([patientId])
  @@map("admissions")
}

// ─────────────────────────────────────────────
//  MEDICATIONS & PHARMACY
// ─────────────────────────────────────────────

model Medication {
  id                   String  @id @default(uuid())
  name                 String
  genericName          String?
  brand                String?
  category             String?
  form                 String?
  strength             String?
  unit                 String?
  manufacturer         String?
  description          String?
  contraindications    String?
  sideEffects          String?
  storageConditions    String?
  requiresPrescription Boolean @default(true)
  isActive             Boolean @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  stockItems        PharmacyStock[]
  prescriptionItems PrescriptionItem[]

  @@map("medications")
}

model PharmacyStock {
  id            String     @id @default(uuid())
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id])
  batchNumber   String
  quantity      Int
  reorderLevel  Int        @default(10)
  purchasePrice Float?
  sellingPrice  Float
  expiryDate    DateTime
  supplier      String?
  receivedDate  DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("pharmacy_stock")
}

model Prescription {
  id              String             @id @default(uuid())
  prescriptionNo  String             @unique
  patientId       String
  patient         Patient            @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor             @relation(fields: [doctorId], references: [id])
  medicalRecordId String?
  medicalRecord   MedicalRecord?     @relation(fields: [medicalRecordId], references: [id])
  status          PrescriptionStatus @default(PENDING)
  prescribedAt    DateTime           @default(now())
  validUntil      DateTime?
  notes           String?
  isRefillable    Boolean            @default(false)
  refillCount     Int                @default(0)
  dispensedAt     DateTime?
  dispensedBy     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items PrescriptionItem[]

  @@index([patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String              @id @default(uuid())
  prescriptionId String
  prescription   Prescription        @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationId   String
  medication     Medication          @relation(fields: [medicationId], references: [id])
  dosage         String
  route          MedicationRoute     @default(ORAL)
  frequency      MedicationFrequency @default(ONCE_DAILY)
  duration       Int?
  durationUnit   String?
  quantity       Int
  instructions   String?
  dispensedQty   Int                 @default(0)

  @@map("prescription_items")
}

// ─────────────────────────────────────────────
//  LABORATORY
// ─────────────────────────────────────────────

model LabTest {
  id             String  @id @default(uuid())
  name           String  @unique
  code           String  @unique
  category       String
  description    String?
  normalRange    String?
  unit           String?
  price          Float
  turnaroundTime Int?
  sampleType     String?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orderItems LabOrderItem[]

  @@map("lab_tests")
}

model LabOrder {
  id              String          @id @default(uuid())
  orderNo         String          @unique
  patientId       String
  patient         Patient         @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor          @relation(fields: [doctorId], references: [id])
  medicalRecordId String?
  medicalRecord   MedicalRecord?  @relation(fields: [medicalRecordId], references: [id])
  priority        LabTestPriority @default(ROUTINE)
  clinicalNotes   String?
  orderedAt       DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items LabOrderItem[]

  @@index([patientId])
  @@map("lab_orders")
}

model LabOrderItem {
  id                String        @id @default(uuid())
  labOrderId        String
  labOrder          LabOrder      @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTestId         String
  labTest           LabTest       @relation(fields: [labTestId], references: [id])
  status            LabTestStatus @default(ORDERED)
  sampleCollectedAt DateTime?
  sampleCollectedBy String?
  resultValue       String?
  resultUnit        String?
  referenceRange    String?
  isAbnormal        Boolean?
  notes             String?
  reportedAt        DateTime?
  reportedBy        String?
  technicianId      String?

  @@map("lab_order_items")
}

// ─────────────────────────────────────────────
//  RADIOLOGY & IMAGING
// ─────────────────────────────────────────────

model RadiologyOrder {
  id                 String          @id @default(uuid())
  orderNo            String          @unique
  patientId          String
  patient            Patient         @relation(fields: [patientId], references: [id])
  doctorId           String
  doctor             Doctor          @relation(fields: [doctorId], references: [id])
  medicalRecordId    String?
  medicalRecord      MedicalRecord?  @relation(fields: [medicalRecordId], references: [id])
  modality           ImagingModality
  bodyPart           String
  clinicalIndication String?
  status             RadiologyStatus @default(ORDERED)
  scheduledAt        DateTime?
  performedAt        DateTime?
  performedBy        String?
  radiologistId      String?
  findings           String?
  impression         String?
  recommendation     String?
  reportedAt         DateTime?
  imageUrls          String[]
  price              Float?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([patientId])
  @@map("radiology_orders")
}

// ─────────────────────────────────────────────
//  SURGERY
// ─────────────────────────────────────────────

model Surgery {
  id               String          @id @default(uuid())
  surgeryNo        String          @unique
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id])
  admissionId      String?
  admission        Admission?      @relation(fields: [admissionId], references: [id])
  leadSurgeonId    String
  leadSurgeon      Doctor          @relation(fields: [leadSurgeonId], references: [id])
  procedureName    String
  icdProcedureCode String?
  priority         SurgeryPriority @default(ELECTIVE)
  status           SurgeryStatus   @default(SCHEDULED)
  operatingRoom    String?
  scheduledAt      DateTime
  startedAt        DateTime?
  endedAt          DateTime?
  duration         Int?
  anesthesiaType   String?
  anesthesiologist String?
  preOpDiagnosis   String?
  postOpDiagnosis  String?
  findings         String?
  complications    String?
  notes            String?
  estimatedCost    Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  staff SurgeryStaff[]

  @@index([patientId])
  @@map("surgeries")
}

model SurgeryStaff {
  id        String  @id @default(uuid())
  surgeryId String
  surgery   Surgery @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id])
  role      String

  @@map("surgery_staff")
}

// ─────────────────────────────────────────────
//  EMERGENCY
// ─────────────────────────────────────────────

model EmergencyVisit {
  id               String            @id @default(uuid())
  visitNo          String            @unique
  patientId        String?
  patient          Patient?          @relation(fields: [patientId], references: [id])
  walkinName       String?
  walkinAge        Int?
  walkinGender     Gender?
  triageTime       DateTime          @default(now())
  chiefComplaint   String
  priority         EmergencyPriority @default(P3_LESS_URGENT)
  status           EmergencyStatus   @default(TRIAGED)
  triageNotes      String?
  assignedDoctorId String?
  roomNo           String?
  vitalSystolic    Int?
  vitalDiastolic   Int?
  vitalHR          Int?
  vitalTemp        Float?
  vitalO2Sat       Float?
  vitalRR          Int?
  treatmentNotes   String?
  dispositionNotes String?
  dischargedAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([triageTime])
  @@map("emergency_visits")
}

// ─────────────────────────────────────────────
//  BILLING
// ─────────────────────────────────────────────

model Bill {
  id             String     @id @default(uuid())
  billNo         String     @unique
  patientId      String
  patient        Patient    @relation(fields: [patientId], references: [id])
  admissionId    String?
  totalAmount    Float      @default(0)
  discountAmount Float      @default(0)
  taxAmount      Float      @default(0)
  netAmount      Float      @default(0)
  paidAmount     Float      @default(0)
  balanceAmount  Float      @default(0)
  status         BillStatus @default(PENDING)
  dueDate        DateTime?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items      BillItem[]
  payments   Payment[]
  insurances BillInsurance[]

  @@index([patientId])
  @@map("bills")
}

model BillItem {
  id          String  @id @default(uuid())
  billId      String
  bill        Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  category    String
  quantity    Int     @default(1)
  unitPrice   Float
  totalPrice  Float
  discount    Float   @default(0)
  notes       String?

  @@map("bill_items")
}

model Payment {
  id          String        @id @default(uuid())
  paymentNo   String        @unique
  billId      String
  bill        Bill          @relation(fields: [billId], references: [id])
  amount      Float
  method      PaymentMethod
  reference   String?
  notes       String?
  processedBy String?
  processedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@map("payments")
}

model BillInsurance {
  id             String    @id @default(uuid())
  billId         String
  bill           Bill      @relation(fields: [billId], references: [id])
  insuranceId    String
  insurance      Insurance @relation(fields: [insuranceId], references: [id])
  claimNo        String?
  claimedAmount  Float?
  approvedAmount Float?
  status         String    @default("PENDING")
  submittedAt    DateTime?
  resolvedAt     DateTime?
  notes          String?

  @@map("bill_insurances")
}

// ─────────────────────────────────────────────
//  REFERRALS
// ─────────────────────────────────────────────

model Referral {
  id                 String   @id @default(uuid())
  referralNo         String   @unique
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id])
  referringDoctorId  String
  referringDoctor    Doctor   @relation("ReferringDoctor", fields: [referringDoctorId], references: [id])
  referredToDoctorId String?
  referredToDoctor   Doctor?  @relation("ReferredToDoctor", fields: [referredToDoctorId], references: [id])
  referredToFacility String?
  reason             String
  urgency            String   @default("ROUTINE")
  notes              String?
  status             String   @default("PENDING")
  referredAt         DateTime @default(now())
  acceptedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("referrals")
}

// ─────────────────────────────────────────────
//  IMMUNIZATION
// ─────────────────────────────────────────────

model Immunization {
  id             String    @id @default(uuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id])
  vaccineName    String
  vaccineCode    String?
  dose           String?
  route          String?
  site           String?
  lotNumber      String?
  expiryDate     DateTime?
  administeredBy String?
  administeredAt DateTime  @default(now())
  nextDoseDate   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([patientId])
  @@map("immunizations")
}

// ─────────────────────────────────────────────
//  NURSE NOTES
// ─────────────────────────────────────────────

model NurseNote {
  id              String         @id @default(uuid())
  patientId       String?
  medicalRecordId String?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  nurseId         String?
  nurse           Nurse?         @relation(fields: [nurseId], references: [id])
  note            String
  noteType        String         @default("GENERAL")
  recordedAt      DateTime       @default(now())

  @@map("nurse_notes")
}

// ─────────────────────────────────────────────
//  STAFF SHIFTS
// ─────────────────────────────────────────────

model Shift {
  id        String    @id @default(uuid())
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shiftType ShiftType
  startTime DateTime
  endTime   DateTime
  isActual  Boolean   @default(false)
  notes     String?
  createdAt DateTime  @default(now())

  @@index([staffId])
  @@index([startTime])
  @@map("shifts")
}

// ─────────────────────────────────────────────
//  DOCUMENTS
// ─────────────────────────────────────────────

model MedicalDocument {
  id             String       @id @default(uuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  type           DocumentType
  title          String
  description    String?
  fileUrl        String
  fileName       String
  fileSize       Int?
  mimeType       String?
  uploadedBy     String?
  uploadedAt     DateTime     @default(now())
  isConfidential Boolean      @default(false)

  @@index([patientId])
  @@map("medical_documents")
}

// ─────────────────────────────────────────────
//  NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  sentVia   String[]
  createdAt DateTime         @default(now())

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────────
//  AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
//  HOSPITAL SETTINGS
// ─────────────────────────────────────────────

model HospitalSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@map("hospital_settings")
}
